<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mnemosyne.Core\Mnemosyne.Core.csproj" />
    <ProjectReference Include="..\Mnemosyne.Protocol\Mnemosyne.Protocol.csproj" />
    <ProjectReference Include="..\..\external\ffxiv_navmesh\DotRecast\src\DotRecast.Core\DotRecast.Core.csproj" />
    <ProjectReference Include="..\..\external\ffxiv_navmesh\DotRecast\src\DotRecast.Detour\DotRecast.Detour.csproj" />
    <ProjectReference Include="..\..\external\ffxiv_navmesh\DotRecast\src\DotRecast.Recast\DotRecast.Recast.csproj" />
